# AutoMateQA Configuration
# Copy this file: cp .env.example .env
# Then fill in the values below.

# ── LLM Provider ─────────────────────────────────────────────────
# Provider: openai | anthropic | local
AQA_LLM_PROVIDER=openai

# Model name (e.g. gpt-4o, claude-sonnet-4-20250514, llama3)
AQA_LLM_MODEL=gpt-4o

# API keys (set the one matching your provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# For local LLMs (Ollama, vLLM, LM Studio) — set base URL
# AQA_LLM_BASE_URL=http://localhost:11434/v1

# ── Healing ──────────────────────────────────────────────────────
# Mode: disabled | strict | auto_update | debug
AQA_HEALING_MODE=disabled

# Minimum confidence to accept a selector match (0.0 - 1.0)
AQA_CONFIDENCE_THRESHOLD=0.75

# ── Browser ──────────────────────────────────────────────────────
# Engine: chromium | firefox | webkit
AQA_BROWSER=chromium

# Run without GUI (true | false)
AQA_HEADLESS=false

# ── Retry ────────────────────────────────────────────────────────
# Strategy: none | linear | exponential
AQA_RETRY_STRATEGY=exponential

# Max retry attempts per step
AQA_MAX_RETRIES=3

# ── Reporting (optional) ─────────────────────────────────────────
# Format: html | junit | json (leave empty to skip)
# AQA_REPORT_FORMAT=html
# AQA_REPORT_PATH=report.html

# ── Dashboard Server ────────────────────────────────────────────
AQA_SERVER_HOST=0.0.0.0
AQA_SERVER_PORT=8000
AQA_WORKERS=1
AQA_LOG_LEVEL=info

# ── MySQL Database ──────────────────────────────────────────────
AQA_DB_HOST=localhost
AQA_DB_PORT=3306
AQA_DB_USER=root
AQA_DB_PASSWORD=automateqa
AQA_DB_NAME=automateqa

# ── S3 Storage ──────────────────────────────────────────────────
AQA_S3_BUCKET=automateqa-tests
AQA_S3_REGION=ap-south-1
AQA_S3_ACCESS_KEY=
AQA_S3_SECRET_KEY=
# For local dev with MinIO:
# AQA_S3_ENDPOINT_URL=http://localhost:9000

# ── Email Notifications (optional) ──────────────────────────────
AQA_SMTP_HOST=smtp.gmail.com
AQA_SMTP_PORT=587
AQA_SMTP_USER=
AQA_SMTP_PASS=
AQA_SMTP_FROM=noreply@automateqa.dev

# ── CORS ────────────────────────────────────────────────────────
AQA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
